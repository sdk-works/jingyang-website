# ============================================
# 环境变量配置文件
# 复制此文件为 .env 并填写真实配置
# ============================================

# 服务器配置
PORT=4000
NODE_ENV=production

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=greenhouse_db
DB_USER=greenhouse_user
DB_PASSWORD=your_strong_password_here

# JWT配置
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
JWT_EXPIRES_IN=7d

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm

# 邮件配置 (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=山东京阳温室科技 <noreply@jingyang-greenhouse.com>

# 销售通知邮件
SALES_EMAIL=sales@jingyang-greenhouse.com
SALES_EMAIL_CC=admin@jingyang-greenhouse.com

# 前端URL (CORS白名单)
FRONTEND_URL=https://www.jingyang-greenhouse.com
FRONTEND_URL_DEV=http://localhost:3000

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WhatsApp
WHATSAPP_NUMBER=8615275898666
